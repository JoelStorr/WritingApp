<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WritingApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="WritingApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WritingApp - Data Ownership Writer">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="270, 4, *, 4, 250">

        <!-- PANE 1: Chapters Sidebar -->
        <Border Grid.Column="0" Background="#1A1A1A" Padding="12">
            <DockPanel>
                <!-- Top Toolbar in Pane 1 -->
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                    <Button Content="📂 Open Folder"
                            Click="OpenFolderButton_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>

                    <TextBlock Text="{Binding CurrentFolderPath, FallbackValue='No folder open'}"
                               Foreground="#777777"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"/>

                    <Separator Margin="0,4"/>

                    <!-- NEW CHAPTER CREATOR -->
                    <TextBlock Text="CREATE NEW CHAPTER" FontWeight="Bold" Foreground="#AAAAAA" FontSize="11"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0"
                                 Name="NewChapterInput"
                                 Watermark="e.g. Chapter 3"
                                 KeyDown="NewChapterInput_KeyDown" />
                        <Button Grid.Column="1"
                                Content="+ Add"
                                Click="CreateChapterButton_Click"
                                Margin="6,0,0,0"/>
                    </Grid>

                    <Separator Margin="0,4"/>
                    <TextBlock Text="MANUSCRIPT FILES" FontWeight="Bold" Foreground="#AAAAAA" FontSize="12"/>
                </StackPanel>
                <!-- Chapter / File List -->
                <ListBox ItemsSource="{Binding Chapters}"
                         SelectedItem="{Binding SelectedChapter}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Splitter 1 -->
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#2A2A2A"/>

        <!-- PANE 2: Center Editor -->
        <Border Grid.Column="2" Background="#141414" Padding="15">
            <avaloniaEdit:TextEditor Name="Editor"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="15"
                                     ShowLineNumbers="False"
                                     WordWrap="True"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalScrollBarVisibility="Auto" />
        </Border>

        <!-- Splitter 2 -->
        <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="#2A2A2A"/>

        <!-- PANE 3: Inspector, Stats & Save -->
        <Border Grid.Column="4" Background="#1A1A1A" Padding="15">
            <StackPanel Spacing="10">
                <TextBlock Text="INSPECTOR" FontWeight="Bold" Foreground="#AAAAAA"/>

                <TextBlock Text="Active File:" Foreground="#888888" FontSize="12"/>
                <TextBlock Text="{Binding SelectedChapter.Title, FallbackValue='None'}" FontWeight="SemiBold" TextWrapping="Wrap"/>

                <Button Content="💾 Save Chapter"
                        Click="SaveButton_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,5,0,0"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#4CAF50"
                           FontSize="11"
                           TextWrapping="Wrap"/>

                <Separator Margin="0,10"/>

                <TextBlock Text="STATISTICS" FontWeight="Bold" Foreground="#AAAAAA"/>

                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Words:" Foreground="#888888"/>
                    <TextBlock Text="{Binding WordCount}" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Characters:" Foreground="#888888"/>
                    <TextBlock Text="{Binding CharCount}"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>