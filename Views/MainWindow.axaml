<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WritingApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="WritingApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WritingApp">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="250, 4, *, 4, 250">

        <!-- PANE 1: Chapters Sidebar -->
        <Border Grid.Column="0" Background="#1A1A1A" Padding="10">
            <DockPanel>
                <TextBlock Text="MANUSCRIPT" FontWeight="Bold" Margin="0,0,0,10" DockPanel.Dock="Top" Foreground="#AAAAAA"/>
                <ListBox ItemsSource="{Binding Chapters}"
                         SelectedItem="{Binding SelectedChapter}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Splitter 1 -->
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#2A2A2A"/>

        <!-- PANE 2: Center Editor (AvaloniaEdit) -->
        <Border Grid.Column="2" Background="#141414" Padding="15">
            <avaloniaEdit:TextEditor Name="Editor"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="15"
                                     ShowLineNumbers="False"
                                     WordWrap="True"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalScrollBarVisibility="Auto" />
        </Border>

        <!-- Splitter 2 -->
        <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="#2A2A2A"/>

        <!-- PANE 3: Chapter Inspector & Stats -->
        <Border Grid.Column="4" Background="#1A1A1A" Padding="15">
            <StackPanel Spacing="10">
                <TextBlock Text="INSPECTOR" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,0,0,10"/>

                <TextBlock Text="Active Chapter:" Foreground="#888888" FontSize="12"/>
                <TextBlock Text="{Binding SelectedChapter.Title, FallbackValue='None'}" FontWeight="SemiBold" TextWrapping="Wrap"/>

                <Separator Margin="0,10"/>

                <TextBlock Text="STATISTICS" FontWeight="Bold" Foreground="#AAAAAA"/>

                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Words:" Foreground="#888888"/>
                    <TextBlock Text="{Binding WordCount}" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Characters:" Foreground="#888888"/>
                    <TextBlock Text="{Binding CharCount}"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>

</Window>